{
  "name": "sap-chat-test-server",
  "version": "1.0.0",
  "description": "SAP Agent Mock Server for local testing (GLM / any OpenAI-compatible LLM)",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "test": "node --env-file-if-exists=.env test-cases.js",
    "test:eval": "node agent-eval-tests.js",
    "test:protocol": "node task-protocol-tests.js",
    "test:frontend": "node frontend-tests.js",
    "test:sessions": "node session-messages-tests.js",
    "test:auth": "node auth-tests.js",
    "test:fiori": "node fiori-tests.js",
    "test:abap": "node abap-static-tests.js",
    "test:skills": "node --test skill-tests.js",
    "test:rptscan": "node rpt-scan-tests.js",
    "test:restore": "node result-restore-tests.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "axios": "^1.6.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
