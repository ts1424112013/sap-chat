{
        "_version": "1.12.0",
        "sap.app": {
                "id": "zai.chat",
                "type": "application",
                "i18n": {
                        "bundleUrl": "i18n/i18n.properties",
                        "supportedLocales": [""],
                        "fallbackLocale": ""
                },
                "applicationVersion": {
                        "version": "1.0.0"
                },
                "title": "{{appTitle}}",
                "description": "{{appDesc}}",
                "dataSources": {
                        "aiChatService": {
                                "uri": "/sap/opu/odata/sap/ZAI_CHAT_SRV/",
                                "type": "OData",
                                "settings": {
                                        "odataVersion": "2.0"
                                }
                        }
                },
                "sourceTemplate": {
                        "id": "html5moduletemplates.basic_sapui5_application_builder_module",
                        "version": "1.0.0"
                }
        },
        "sap.ui": {
                "technology": "UI5",
                "icons": {
                        "icon": "images/momo-mark.svg",
                        "favIcon": "images/momo-mark.svg",
                        "phone": "",
                        "phone@2": "",
                        "tablet": "",
                        "tablet@2": ""
                },
                "deviceTypes": {
                        "desktop": true,
                        "tablet": true,
                        "phone": true
                }
        },
        "sap.ui5": {
                "rootView": {
                        "viewName": "zai.chat.view.App",
                        "type": "XML",
                        "async": true,
                        "id": "app"
                },
                "dependencies": {
                        "minUI5Version": "1.108.0",
                        "libs": {
                                "sap.ui.core": {},
                                "sap.m": {},
                                "sap.ui.layout": {}
                        }
                },
                "contentDensities": {
                        "compact": true,
                        "cozy": true
                },
                "resources": {
                        "css": [
                                {
                                        "uri": "css/style.css"
                                },
                                {
                                        "uri": "css/style-patches.css"
                                },
                                {
                                        "uri": "css/style-features.css"
                                },
                                {
                                        "uri": "css/style-gale.css"
                                },
                                {
                                        "uri": "css/style-skills.css"
                                },
                                {
                                        "uri": "css/style-momo.css"
                                }
                        ]
                },
                "models": {
                        "i18n": {
                                "type": "sap.ui.model.resource.ResourceModel",
                                "settings": {
                                        "bundleName": "zai.chat.i18n.i18n",
                                        "supportedLocales": [""],
                                        "fallbackLocale": ""
                                }
                        }
                }
        }
}
