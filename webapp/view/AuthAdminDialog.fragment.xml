<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

        <!-- ======================= 权限审批（管理入口，仅 ADMIN；侧栏「权限审批」打开，内容见 AuthAdmin 片段） ======================= -->
        <Dialog id="authAdminDialog" title="{i18n>authAdmin}" contentWidth="64rem" resizable="true" draggable="true" class="authDialog authAdminDialog">
                <content>
                        <core:Fragment fragmentName="zai.chat.view.AuthAdmin" type="XML"/>
                </content>
                <buttons>
                        <Button text="{i18n>close}" press=".onCloseAuthAdmin"/>
                </buttons>
        </Dialog>

</core:FragmentDefinition>
