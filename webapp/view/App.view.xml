<mvc:View controllerName="zai.chat.controller.App"
        displayBlock="true"
        height="100%"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:f="sap.ui.layout.form"
        xmlns:u="sap.ui.unified"
        xmlns:core="sap.ui.core">

        <App id="app">
                <pages>
                        <Page id="page" title="" showHeader="false" enableScrolling="false">
                                <content>
                                        <HBox height="100%" class="mainRow">

                                                <!-- ==================== 左侧边栏：品牌 / 工作模式 / 新建 / 历史 ==================== -->
                                                <VBox id="sideBar" class="sideBar" width="17rem">
                                                        <!-- V16：Gale-SAP 品牌（疾风标 + 字标） -->
                                                        <HBox class="brandRow" alignItems="Center">
                                                                <Image src="images/gale-mark.svg" width="30px" height="30px" decorative="true" densityAware="false" class="brandLogoImage"/>
                                                                <Title level="H3" text="{i18n>brandName}" class="brandName"/>
                                                        </HBox>

                                                        <!-- V12/V13：工作模式分段控件（对话 / Agent）——横向等宽，选中态纯 CSS -->
                                                        <VBox id="modeNav" class="modeNav">
                                                                <Button id="chatModeNav" type="Transparent"
                                                                        icon="sap-icon://discussion"
                                                                        text="{i18n>modeNavChat}"
                                                                        tooltip="{i18n>modeNavChatTip}"
                                                                        press=".onSelectWorkspaceMode"
                                                                        class="modeNavBtn">
                                                                        <customData>
                                                                                <core:CustomData key="mode" value="CHAT"/>
                                                                        </customData>
                                                                </Button>
                                                                <Button id="agentModeNav" type="Transparent"
                                                                        icon="sap-icon://lightbulb"
                                                                        text="{i18n>modeNavAgent}"
                                                                        tooltip="{i18n>modeNavAgentTip}"
                                                                        press=".onSelectWorkspaceMode"
                                                                        class="modeNavBtn">
                                                                        <customData>
                                                                                <core:CustomData key="mode" value="AGENT"/>
                                                                        </customData>
                                                                </Button>
                                                        </VBox>

                                                        <Button id="newChatBtn" text="{chat>/newBtnLabel}" icon="sap-icon://add" press=".onNewSession"/>

                                                        <Text text="{chat>/histLabel}" class="histLabel"/>

                                                        <!-- V10：会话搜索（前端按标题过滤） -->
                                                        <SearchField id="sessionSearch"
                                                                placeholder="{i18n>sessSearch}"
                                                                liveChange=".onSearchSession"
                                                                class="sessSearch"/>

                                                        <!-- 历史会话列表：后端模式读 ZAI_CHAT_SESS，演示模式存本地 -->
                                                        <List id="sessionList"
                                                                items="{path: 'session>/sessions', factory: '.sessionItemFactory', templateShareable: false}"
                                                                showSeparators="None"
                                                                backgroundDesign="Transparent"
                                                                noDataText="{i18n>noSessions}"
                                                                class="sessionList">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                        </List>

                                                        <!-- 20261020：权限入口（会话列表与用户卡之间）：申请权限（所有人）/ 权限审批（仅 ADMIN，红色角标 = 待审批条数） -->
                                                        <VBox class="sideAuth">
                                                                <Button icon="sap-icon://key" text="{i18n>authApply}" type="Transparent" press=".onOpenAuth" width="100%" class="sideAuthBtn"/>
                                                                <HBox renderType="Bare" class="sideAuthRow" visible="{settings>/isAdmin}">
                                                                        <Button icon="sap-icon://approvals" text="{i18n>authAdmin}" type="Transparent" press=".onOpenAuthApprove" width="100%"
                                                                                tooltip="{= ${settings>/authPending} > 0 ? ${settings>/authPendingTip} : ${i18n>authAdmin} }" class="sideAuthBtn"/>
                                                                        <Text text="{= ${settings>/authPending} > 99 ? '99+' : String(${settings>/authPending}) }" visible="{= ${settings>/authPending} > 0 }" class="sideAuthBadge"/>
                                                                </HBox>
                                                        </VBox>

                                                        <!-- V16：底部用户卡（头像 · 姓名 · 连接状态 · 设置） -->
                                                        <HBox class="sideFoot" alignItems="Center">
                                                                <Avatar initials="{settings>/userInitials}" displaySize="XS" backgroundColor="Accent6" class="sideAvatar"/>
                                                                <VBox class="sideUser">
                                                                        <layoutData><FlexItemData growFactor="1"/></layoutData>
                                                                        <Text text="{settings>/userName}" class="sideUserName" wrapping="false"/>
                                                                        <ObjectStatus id="modeBadge" class="modeBadge"/>
                                                                </VBox>
                                                                <Button icon="sap-icon://action-settings" type="Transparent" press=".onOpenSettings" tooltip="{i18n>settings}" class="sideSetBtn"/>
                                                        </HBox>
                                                </VBox>

                                                <!-- ==================== 主区域 ==================== -->
                                                <VBox width="100%" class="mainCol">

                                                        <!-- 顶栏：折叠侧栏 / 工作模式徽标 / 当前会话标题 / 模型切换 / 设置 -->
                                                        <Toolbar class="topBar">
                                                                <Button id="sideToggle" icon="sap-icon://menu2" type="Transparent" press=".onToggleSide" tooltip="{i18n>toggleSide}" class="topBtn"/>
                                                                <!-- V12：当前工作模式徽标（对话 / Agent · 类型） -->
                                                                <Text id="topModeBadge" text="{chat>/modeLabel}" class="topModeBadge"/>
                                                                <!-- V15/V16：当前业务任务徽标（模块 · 状态；点击查看会话任务） -->
                                                                <ObjectStatus id="taskBadge"
                                                                        text="{chat>/taskBadge}"
                                                                        state="{chat>/taskBadgeState}"
                                                                        tooltip="{chat>/taskBadgeTip}"
                                                                        active="true"
                                                                        press=".onTaskListPress"
                                                                        visible="{= ${chat>/taskBadge} !== '' }"
                                                                        class="taskBadge"/>
                                                                <Text text="{session>/title}" class="sessTitle"/>
                                                                <ToolbarSpacer/>
                                                                <!-- V16：运行指示（生成中 / Agent 运行中 / 报表后台执行中） -->
                                                                <Text text="{chat>/activityText}" visible="{= ${chat>/activityText} !== '' }" class="activityPill"/>
                                                                        <!-- V12：Agent 任务信息入口（仅 Agent 任务会话可见） -->
                                                                        <Button id="agentInfoBtn" icon="sap-icon://information" type="Transparent"
                                                                                tooltip="{i18n>agentInfoBtn}" press=".onAgentTaskInfo"
                                                                                visible="{chat>/agentInfoVisible}" class="topBtn"/>
                                                                        <!-- V6.0：明暗主题切换（持久化见 App.controller onToggleTheme） -->
                                                                        <Button id="themeToggle" icon="sap-icon://night-mode" type="Transparent" press=".onToggleTheme" tooltip="{i18n>themeToggle}" class="topBtn themeToggle"/>
                                                                        <!-- V16：导出合并为一个菜单（设置入口统一在侧栏底部） -->
                                                                        <MenuButton icon="sap-icon://download" type="Transparent" tooltip="{i18n>exportMenu}" class="topBtn topMenuBtn">
                                                                                <menu>
                                                                                        <Menu>
                                                                                                <MenuItem text="{i18n>exportMd}" icon="sap-icon://document-text" press=".onExportSession"/>
                                                                                                <MenuItem text="{i18n>exportCsv}" icon="sap-icon://excel-attachment" press=".onExportCsv"/>
                                                                                        </Menu>
                                                                                </menu>
                                                                        </MenuButton>
                                                        </Toolbar>

                                                        <!-- ============ 空状态：居中大输入框（对话/Agent 两模式复用，文案随模式） ============ -->
                                                        <VBox id="hero" class="heroArea" alignItems="Center" justifyContent="Center" visible="{chat>/heroVisible}">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                                <Image src="images/gale-mark.svg" width="52px" height="52px" decorative="true" densityAware="false" class="heroMark"/>
                                                                <Title level="H2" text="{chat>/heroTitle}" class="heroTitle"/>
                                                                <!-- V7：hero 副标题；V13：Agent 模式换为 Agent 引导文案 -->
                                                                <Text text="{chat>/heroSub}" class="heroSub"/>
                                                                <!-- 20261011：Agent 场景选择（新会话首条消息前可选，之后固定；控制器 _renderScenePicker 渲染） -->
                                                                <HBox id="scenePicker" class="scenePicker" wrap="Wrap" justifyContent="Center" visible="false"/>

                                                                <!-- V4.3：输入卡（含内部右下角发送键）保持原结构，仅位于胶囊下方 -->
                                                                <VBox class="inputCard heroCard" width="100%">
                                                                        <TextArea id="heroInput"
                                                                                growing="true"
                                                                                growingMaxLines="7"
                                                                                rows="2"
                                                                                width="100%"
                                                                                placeholder="{chat>/heroPh}"
                                                                                valueLiveUpdate="true"
                                                                                value="{chat>/input}"
                                                                                liveChange=".onSkillInputChange"
                                                                                class="chatInput"/>
                                                                        <!-- V9.3：附件回显行（已选附件名 + 移除），默认隐藏；
                                                                             V13：Agent 模式附件作为任务上下文，同样支持 -->
                                                                        <HBox id="attachRowHero" visible="false" alignItems="Center" class="attachRow">
                                                                                <Text id="attachNameHero" class="attachName"/>
                                                                                <Button id="attachDelHero" icon="sap-icon://decline" type="Transparent"
                                                                                        tooltip="{i18n>attachRemove}" press=".onAttachRemove" class="attachDel"/>
                                                                        </HBox>
                                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="inputFoot">
                                                                                <!-- V5.4：角色选择（仅对话模式；Agent 模式不用角色前缀） -->
                                                                                <HBox alignItems="Center" class="roleBox"
                                                                                        visible="{= ${chat>/workspaceMode} === 'CHAT' }">
                                                                                        <ComboBox id="roleSelectHero"
                                                                                                width="10rem"
                                                                                                placeholder="{i18n>roleNone}"
                                                                                                tooltip="{i18n>roleTip}"
                                                                                                change=".onRoleChange"
                                                                                                class="roleCombo"/>
                                                                                        <Button id="roleMngHero" icon="sap-icon://user-edit" type="Transparent"
                                                                                                tooltip="{i18n>roleManage}" press=".onOpenRoleManage" class="roleMngBtn"/>
                                                                                </HBox>
                                                                                <!-- 20261020：模型选择（会话级，每个对话各自记住；对话 / Agent 两模式都显示） -->
                                                                                <HBox alignItems="Center" class="skillSlot" visible="{skill>/visible}">
                                                                                        <Button id="skillBtnHero" text="{skill>/label}" icon="sap-icon://learning-assistant" type="Transparent"
                                                                                                tooltip="{skill>/hint}" enabled="{= ${skill>/canPick} &amp;&amp; !${chat>/busy} }" press=".onOpenSkills" class="skillPill"/>
                                                                                        <Button icon="sap-icon://refresh" type="Transparent" tooltip="重新读取技能" press=".onRefreshSkills"
                                                                                                visible="{= !!${skill>/error} }" enabled="{= !${chat>/busy} }" class="skillClear"/>
                                                                                        <Button icon="sap-icon://decline" type="Transparent" tooltip="取消技能" press=".onClearSkill"
                                                                                                visible="{= !!${skill>/selected} }" enabled="{= !${chat>/busy} }" class="skillClear"/>
                                                                                        <Button icon="sap-icon://hint" type="Transparent" tooltip="查看做法" press=".onViewSkill"
                                                                                                visible="{= !!${skill>/selected} }" class="skillClear"/>
                                                                                </HBox>
                                                                                <Button id="modelBtnHero" icon="sap-icon://ai" text="{chat>/currentModelName}" tooltip="{i18n>modelPickTip}"
                                                                                        type="Transparent" press=".onOpenModelPicker" class="modelPill"/>
                                                                                <!-- V9.3：文本附件上传 + 发送；
                                                                                     V13：Agent 模式下附件按钮保留（作为上下文）
                                                                                     20261012：inputActions 恒靠右（Agent 模式左侧角色区隐藏时不再被挤到左下角） -->
                                                                                <HBox alignItems="Center" class="inputActions">
                                                                                        <u:FileUploader id="attachHero"
                                                                                                buttonOnly="true"
                                                                                                buttonText=""
                                                                                                icon="sap-icon://attachment"
                                                                                                style="Transparent"
                                                                                                tooltip="{i18n>attachTip}"
                                                                                                change=".onFileChosen"
                                                                                                uploadOnChange="false"
                                                                                                class="attachBtn"/>
                                                                                        <Button id="sendBtnHero" icon="sap-icon://paper-plane" press=".onSend" type="Emphasized" tooltip="{i18n>send}" class="sendBtn"/>
                                                                                </HBox>
                                                                        </HBox>
                                                                </VBox>
                                                                <Text text="{skill>/hint}" visible="{skill>/visible}" class="skillHint"/>
                                                                <!-- V16：建议标签（输入卡下方一行，点击填入输入框；替代原漂浮泡泡，
                                                                     对话 = 快捷指令，Agent = 示例问题；控制器 _renderHeroBubbles 渲染） -->
                                                                <HBox id="bubbleField" class="heroChips" wrap="Wrap" justifyContent="Center"/>
                                                                <!-- 20261020：报表目录（「报表执行」「Fiori 报表」场景的空会话首页；CatalogPanel 渲染，其余场景隐藏） -->
                                                                <VBox id="catalogHost" class="catalogHost" width="100%" visible="false"/>
                                                        </VBox>

                                                        <!-- ============ 对话态：消息列表 ============ -->
                                                        <ScrollContainer id="chatScroll" height="100%" width="100%" vertical="true" horizontal="false" visible="{chat>/listVisible}">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                                <List id="msgList"
                                                                        items="{path: 'chat>/messages', factory: '.msgItemFactory', templateShareable: false}"
                                                                        showSeparators="None"
                                                                        backgroundDesign="Transparent"/>
                                                        </ScrollContainer>

                                                        <!-- V16：原底部任务区（参数表单/运行状态行）已并入对话：
                                                             参数 → 回复内联确认卡；运行 → 回复内步骤条 -->

                                                        <!-- ============ 对话态：底部输入 ============ -->
                                                        <HBox class="inputDock" justifyContent="Center" visible="{chat>/listVisible}">
                                                                <!-- V16：回到底部浮钮（离底部较远时出现） -->
                                                                <Button icon="sap-icon://navigation-down-arrow" type="Transparent"
                                                                        tooltip="{i18n>jumpBottom}" press=".onJumpBottom"
                                                                        visible="{chat>/jumpVisible}" class="jumpBtn"/>
                                                                <VBox class="inputCard" width="100%">
                                                                        <!-- V5.4：对话态不再显示快捷指令行（仅首页泡泡形式保留）
                                                                             V12：占位文案随模式（Agent = 任务输入）；角色/附件仅对话模式可用 -->
                                                                        <TextArea id="msgInput"
                                                                                growing="true"
                                                                                growingMaxLines="7"
                                                                                rows="1"
                                                                                width="100%"
                                                                                placeholder="{chat>/inputPh}"
                                                                                valueLiveUpdate="true"
                                                                                value="{chat>/input}"
                                                                                liveChange=".onSkillInputChange"
                                                                                class="chatInput"/>
                                                                        <!-- V9.3：附件回显行（V12：仅对话模式显示，控制器统一同步） -->
                                                                        <HBox id="attachRowDock" visible="false" alignItems="Center" class="attachRow">
                                                                                <Text id="attachNameDock" class="attachName"/>
                                                                                <Button id="attachDelDock" icon="sap-icon://decline" type="Transparent"
                                                                                        tooltip="{i18n>attachRemove}" press=".onAttachRemove" class="attachDel"/>
                                                                        </HBox>
                                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="inputFoot">
                                                                                <!-- V5.4：左侧角色选择（V12：Agent 模式隐藏 —— 角色前缀不进入任务提问） -->
                                                                                <HBox alignItems="Center" class="roleBox"
                                                                                        visible="{= ${chat>/workspaceMode} === 'CHAT' }">
                                                                                        <ComboBox id="roleSelectDock"
                                                                                                width="10rem"
                                                                                                placeholder="{i18n>roleNone}"
                                                                                                tooltip="{i18n>roleTip}"
                                                                                                change=".onRoleChange"
                                                                                                class="roleCombo"/>
                                                                                        <Button id="roleMngDock" icon="sap-icon://user-edit" type="Transparent"
                                                                                                tooltip="{i18n>roleManage}" press=".onOpenRoleManage" class="roleMngBtn"/>
                                                                                </HBox>
                                                                                <!-- 20261020：模型选择（会话级） -->
                                                                                <HBox alignItems="Center" class="skillSlot" visible="{skill>/visible}">
                                                                                        <Button id="skillBtnDock" text="{skill>/label}" icon="sap-icon://learning-assistant" type="Transparent"
                                                                                                tooltip="{skill>/hint}" enabled="{= ${skill>/canPick} &amp;&amp; !${chat>/busy} }" press=".onOpenSkills" class="skillPill"/>
                                                                                        <Button icon="sap-icon://refresh" type="Transparent" tooltip="重新读取技能" press=".onRefreshSkills"
                                                                                                visible="{= !!${skill>/error} }" enabled="{= !${chat>/busy} }" class="skillClear"/>
                                                                                        <Button icon="sap-icon://decline" type="Transparent" tooltip="取消技能" press=".onClearSkill"
                                                                                                visible="{= !!${skill>/selected} }" enabled="{= !${chat>/busy} }" class="skillClear"/>
                                                                                        <Button icon="sap-icon://hint" type="Transparent" tooltip="查看做法" press=".onViewSkill"
                                                                                                visible="{= !!${skill>/selected} }" class="skillClear"/>
                                                                                </HBox>
                                                                                <Button id="modelBtnDock" icon="sap-icon://ai" text="{chat>/currentModelName}" tooltip="{i18n>modelPickTip}"
                                                                                        type="Transparent" press=".onOpenModelPicker" class="modelPill"/>
                                                                                <!-- V9.3：文本附件上传（V13：Agent 模式保留 —— 附件作为任务上下文拼入提问）
                                                                                     20261012：inputActions 恒靠右 -->
                                                                                <HBox alignItems="Center" class="inputActions">
                                                                                        <u:FileUploader id="attachDock"
                                                                                                buttonOnly="true"
                                                                                                buttonText=""
                                                                                                icon="sap-icon://attachment"
                                                                                                style="Transparent"
                                                                                                tooltip="{i18n>attachTip}"
                                                                                                change=".onFileChosen"
                                                                                                uploadOnChange="false"
                                                                                                class="attachBtn"/>
                                                                                        <Button id="sendBtn" icon="sap-icon://paper-plane" press=".onSend" type="Emphasized" tooltip="{i18n>send}" class="sendBtn"/>
                                                                                </HBox>
                                                                        </HBox>
                                                                        <Text text="{skill>/hint}" visible="{skill>/visible}" class="skillHint"/>
                                                                </VBox>
                                                        </HBox>
                                                </VBox>
                                        </HBox>
                                </content>
                        </Page>
                </pages>
        </App>
</mvc:View>
