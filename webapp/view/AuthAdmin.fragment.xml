<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

        <!-- ======================= 权限管理内容（仅 ADMIN）：申请记录 / 批量代加 / 权限表配置 / 事务码规则 =======================
             根节点 = 固定头部（标题 + 说明 + 开关 / 刷新 / 关闭 + 下划线页签）+ 可滚动内容 + 固定页脚（各页签自己的主操作）。
             申请记录：状态胶囊筛选 + 一条申请一行；批量代加：竖排表单；权限表 / 规则：左上已有项（点选载入）+ 编辑区。
             样式：外壳复用 .apvDialog / .apv*，表单输入复用 .aplInput，本对话框自己的是 .adm*（style-gale.css）。 -->
        <VBox renderType="Bare" class="apvRoot">

                <!-- ===== 头部 ===== -->
                <VBox class="apvHead">
                        <HBox alignItems="Start" class="apvHeadRow">
                                <VBox class="apvHeadText">
                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                        <Title level="H3" text="{i18n>admTitle}" class="apvTitle"/>
                                        <Text text="{i18n>admSub}" class="apvSub"/>
                                </VBox>
                                <HBox alignItems="Center" class="admEnable">
                                        <Text text="{i18n>authEnabled}" class="admEnableText"/>
                                        <Switch state="{auth>/enabled}" change=".onAuthEnabledChange"/>
                                </HBox>
                                <Button icon="sap-icon://refresh" tooltip="{i18n>authRefresh}" type="Transparent" press=".onAuthRefreshAdmin" class="apvHeadBtn"/>
                                <Button icon="sap-icon://decline" tooltip="{i18n>close}" type="Transparent" press=".onCloseAuthAdmin" class="apvHeadBtn"/>
                        </HBox>
                        <HBox renderType="Bare" class="apvTabs">
                                <Button text="{i18n>authTabRecords}" type="Transparent" press=".onAdmTab" class="apvTabBtn">
                                        <customData>
                                                <core:CustomData key="tab" value="records"/>
                                                <core:CustomData key="on" value="{= ${auth>/admTab} === 'records' ? 'yes' : 'no' }" writeToDom="true"/>
                                        </customData>
                                </Button>
                                <Button text="{i18n>authTabBatch}" type="Transparent" press=".onAdmTab" class="apvTabBtn">
                                        <customData>
                                                <core:CustomData key="tab" value="batch"/>
                                                <core:CustomData key="on" value="{= ${auth>/admTab} === 'batch' ? 'yes' : 'no' }" writeToDom="true"/>
                                        </customData>
                                </Button>
                                <Button text="{i18n>authTabTables}" type="Transparent" press=".onAdmTab" class="apvTabBtn">
                                        <customData>
                                                <core:CustomData key="tab" value="tables"/>
                                                <core:CustomData key="on" value="{= ${auth>/admTab} === 'tables' ? 'yes' : 'no' }" writeToDom="true"/>
                                        </customData>
                                </Button>
                                <Button text="{i18n>authTabRules}" type="Transparent" press=".onAdmTab" class="apvTabBtn">
                                        <customData>
                                                <core:CustomData key="tab" value="rules"/>
                                                <core:CustomData key="on" value="{= ${auth>/admTab} === 'rules' ? 'yes' : 'no' }" writeToDom="true"/>
                                        </customData>
                                </Button>
                        </HBox>
                </VBox>

                <!-- ===== 内容（只有这里滚动） ===== -->
                <VBox id="admScroll" renderType="Bare" class="apvScroll" busy="{auth>/busy}" busyIndicatorDelay="200">
                        <MessageStrip text="{auth>/notice}" type="Error" showIcon="true" visible="{= !!${auth>/notice} }" class="apvStrip"/>
                        <MessageStrip text="{i18n>authDisabled}" type="Warning" showIcon="true" visible="{= !${auth>/enabled} }" class="apvStrip"/>

                        <!-- ==================== 申请记录 ==================== -->
                        <VBox renderType="Bare" class="apvPane" visible="{= ${auth>/admTab} === 'records' }">

                                <HBox renderType="Bare" wrap="Wrap" class="admPills">
                                        <Button text="{i18n>authAllStatus}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value=""/>
                                                        <core:CustomData key="on" value="{= !${auth>/admin/status} ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusPENDING}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="PENDING"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'PENDING' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusDONE}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="DONE"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'DONE' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusEXISTS}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="EXISTS"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'EXISTS' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusREJECTED}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="REJECTED"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'REJECTED' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusFAILED}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="FAILED"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'FAILED' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                        <Button text="{i18n>authStatusREVOKED}" type="Transparent" press=".onAdmStatus" class="admPill">
                                                <customData>
                                                        <core:CustomData key="status" value="REVOKED"/>
                                                        <core:CustomData key="on" value="{= ${auth>/admin/status} === 'REVOKED' ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                        </Button>
                                </HBox>

                                <HBox renderType="Bare" class="admFilters">
                                        <Input value="{auth>/admin/user}" placeholder="{i18n>authFilterUserPh}" maxLength="12" submit=".onAuthRefreshAdmin" class="aplInput admFilterUser"/>
                                        <Input value="{auth>/admin/tcode}" placeholder="{i18n>authTcodePh}" maxLength="20" submit=".onAuthRefreshAdmin" class="aplInput aplMono admFilterTcode"/>
                                        <Input value="{auth>/admin/note}" placeholder="{i18n>authNotePh}" maxLength="255" class="aplInput admFilterNote">
                                                <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                        </Input>
                                </HBox>

                                <VBox items="{path: 'auth>/admin/rows', templateShareable: false}" class="apvDoneList">
                                        <HBox alignItems="Start" class="admRow">
                                                <VBox class="apvMain">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <HBox alignItems="Center" class="apvChips admChips">
                                                                <Text text="{auth>targetUser}" class="admUser"/>
                                                                <Text text="{auth>whoSub}" class="admWho" wrapping="false" visible="{= !!${auth>whoSub} }"/>
                                                                <Text text="{auth>tcode}" class="apvChip apvChipTcode"/>
                                                                <Text text="{auth>werksText}" class="apvChip"/>
                                                                <Text text="{auth>tabname}" class="apvTabname" visible="{= !!${auth>tabname} }"/>
                                                        </HBox>
                                                        <Text text="{auth>recSub}" class="aplMsg"/>
                                                        <Text text="{= ${i18n>authColReason} + '：' + ${auth>reason} }" class="admReason" visible="{= !!${auth>reason} }"/>
                                                        <Text text="{auth>message}" class="aplMsg" visible="{= !!${auth>message} }"/>
                                                </VBox>
                                                <VBox alignItems="End" class="admSide">
                                                        <Text text="{auth>statusText}" class="apvStatus" wrapping="false">
                                                                <customData>
                                                                        <core:CustomData key="status" value="{auth>status}" writeToDom="true"/>
                                                                </customData>
                                                        </Text>
                                                        <HBox class="admActs" visible="{= ${auth>canDecide} || ${auth>canRevoke} }">
                                                                <Button text="{i18n>authApprove}" type="Emphasized" visible="{auth>canDecide}" press=".onAuthApprove" class="apvBtn admBtn"/>
                                                                <Button text="{i18n>authReject}" type="Transparent" visible="{auth>canDecide}" press=".onAuthReject" class="apvBtn apvBtnReject admBtn"/>
                                                                <Button text="{i18n>authRevoke}" type="Transparent" visible="{auth>canRevoke}" press=".onAuthRevoke" class="apvBtn apvBtnReject admBtn"/>
                                                        </HBox>
                                                </VBox>
                                        </HBox>
                                </VBox>

                                <VBox alignItems="Center" class="apvEmpty" visible="{= !${auth>/busy} &amp;&amp; ${auth>/admin/rows}.length === 0 }">
                                        <core:Icon src="sap-icon://list" class="apvEmptyIcon apvEmptyIconMuted"/>
                                        <Text text="{i18n>authNoRequests}" class="apvEmptyTitle"/>
                                        <Text text="{i18n>admEmptySub}" class="apvEmptySub"/>
                                </VBox>
                        </VBox>

                        <!-- ==================== 批量代加 ==================== -->
                        <VBox renderType="Bare" class="apvPane" visible="{= ${auth>/admTab} === 'batch' }">

                                <!-- 本次结果：逐条一行 -->
                                <VBox renderType="Bare" class="aplResult" visible="{= ${auth>/result/lines}.length > 0 }">
                                        <Text text="{auth>/result/summary}" class="aplResultHead"/>
                                        <VBox items="{path: 'auth>/result/lines', templateShareable: false}" class="apvDoneList">
                                                <HBox alignItems="Center" class="aplRow">
                                                        <VBox class="apvMain">
                                                                <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                                <HBox alignItems="Center" class="apvChips admChips">
                                                                        <Text text="{auth>targetUser}" class="admUser" visible="{= !!${auth>targetUser} }"/>
                                                                        <Text text="{auth>tcode}" class="apvChip apvChipTcode"/>
                                                                        <Text text="{auth>werksText}" class="apvChip"/>
                                                                        <Text text="{auth>tabname}" class="apvTabname" visible="{= !!${auth>tabname} }"/>
                                                                </HBox>
                                                                <Text text="{auth>message}" class="aplMsg" visible="{= !!${auth>message} }"/>
                                                        </VBox>
                                                        <Text text="{auth>statusText}" class="apvStatus" wrapping="false">
                                                                <customData>
                                                                        <core:CustomData key="status" value="{auth>status}" writeToDom="true"/>
                                                                </customData>
                                                        </Text>
                                                </HBox>
                                        </VBox>
                                </VBox>

                                <VBox renderType="Bare" class="aplField">
                                        <Text text="{i18n>authUsers}" class="aplLabel aplReq"/>
                                        <TextArea value="{auth>/batch/users}" placeholder="{i18n>authUsersPh}" rows="3" width="100%" class="aplInput aplMono"/>
                                </VBox>
                                <HBox renderType="Bare" class="admTwoCol">
                                        <VBox renderType="Bare" class="aplField">
                                                <Text text="{i18n>authTcode}" class="aplLabel aplReq"/>
                                                <Input value="{auth>/batch/tcode}" placeholder="{i18n>authTcodePh}" maxLength="20" class="aplInput aplMono"/>
                                        </VBox>
                                        <VBox renderType="Bare" class="aplField">
                                                <Text text="{i18n>authWerks}" class="aplLabel aplReq"/>
                                                <Input value="{auth>/batch/werks}" placeholder="{i18n>authBatchWerksPh}" class="aplInput aplMono"/>
                                                <Text text="{i18n>admBatchWerksHint}" class="aplHint"/>
                                        </VBox>
                                </HBox>
                                <VBox renderType="Bare" class="aplField">
                                        <Text text="{i18n>authReason}" class="aplLabel aplReq"/>
                                        <TextArea value="{auth>/batch/reason}" placeholder="{i18n>authReasonPh}" maxLength="255" rows="2" width="100%" class="aplInput"/>
                                </VBox>
                        </VBox>

                        <!-- ==================== 权限表配置 ==================== -->
                        <VBox renderType="Bare" class="apvPane" visible="{= ${auth>/admTab} === 'tables' }">
                                <Text text="{i18n>authTableHint}" class="admNote"/>

                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="admSecHead">
                                        <Text text="{= ${i18n>admTablesTitle} + '  ·  ' + ${auth>/tables}.length }" class="admSecTitle"/>
                                        <Button text="{i18n>admNew}" icon="sap-icon://add" type="Transparent" press=".onAuthNewTable" class="admLink"/>
                                </HBox>
                                <List items="{path: 'auth>/tables', templateShareable: false}" itemPress=".onAuthPickTable" showSeparators="None" noDataText="{i18n>authNoTables}" class="admPickList">
                                        <CustomListItem type="Active" class="admPickItem">
                                                <customData>
                                                        <core:CustomData key="on" value="{= ${auth>tabname} === ${auth>/editTable/tabname} ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                                <HBox alignItems="Center" class="admPickRow">
                                                        <VBox renderType="Bare" class="apvMain">
                                                                <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                                <HBox alignItems="Center" class="admChips">
                                                                        <Text text="{auth>tabname}" class="apvChip apvChipTcode"/>
                                                                        <Text text="{i18n>admDiscoverTag}" class="apvChip" visible="{= ${auth>discover} === 'X' }"/>
                                                                </HBox>
                                                                <Text text="{auth>descr}" class="aplMsg" visible="{= !!${auth>descr} }"/>
                                                        </VBox>
                                                        <Text text="{auth>activeText}" class="apvStatus" wrapping="false">
                                                                <customData>
                                                                        <core:CustomData key="status" value="{= ${auth>active} === 'X' ? 'DONE' : 'OFF' }" writeToDom="true"/>
                                                                </customData>
                                                        </Text>
                                                </HBox>
                                        </CustomListItem>
                                </List>

                                <VBox renderType="Bare" class="admEditor">
                                        <Text text="{i18n>admEditTable}" class="admSecTitle"/>
                                        <HBox alignItems="End" class="admInline">
                                                <VBox renderType="Bare" class="aplField">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <Text text="{i18n>authColTable}" class="aplLabel aplReq"/>
                                                        <Input value="{auth>/editTable/tabname}" placeholder="{i18n>authTablePh}" maxLength="30" submit=".onAuthDescribe" class="aplInput aplMono"/>
                                                </VBox>
                                                <Button text="{i18n>authDescribe}" icon="sap-icon://inspect" type="Transparent" press=".onAuthDescribe" class="admOutlineBtn"/>
                                        </HBox>
                                        <VBox renderType="Bare" class="aplField">
                                                <Text text="{i18n>authDescr}" class="aplLabel"/>
                                                <Input value="{auth>/editTable/descr}" maxLength="60" class="aplInput"/>
                                        </VBox>
                                        <HBox alignItems="Center" class="admToggle">
                                                <VBox renderType="Bare" class="apvMain">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <Text text="{i18n>authDiscover}" class="admToggleTitle"/>
                                                        <Text text="{i18n>authDiscoverTip}" class="aplMsg"/>
                                                </VBox>
                                                <Switch state="{auth>/editTable/discover}"/>
                                        </HBox>
                                        <HBox alignItems="Center" class="admToggle">
                                                <VBox renderType="Bare" class="apvMain">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <Text text="{i18n>authActive}" class="admToggleTitle"/>
                                                </VBox>
                                                <Switch state="{auth>/editTable/active}"/>
                                        </HBox>
                                </VBox>

                                <!-- 字段映射（列表与事务码规则共用 AuthFieldMap 片段；本卡片绑定 /editTable） -->
                                <VBox renderType="Bare" class="admEditor" binding="{auth>/editTable}">
                                        <Text text="{i18n>admMapTitle}" class="admSecTitle"/>
                                        <Text text="{auth>ownRulesText}" class="admNote admNoteTight" visible="{= !!${auth>ownRulesText} }"/>
                                        <core:Fragment fragmentName="zai.chat.view.AuthFieldMap" type="XML"/>
                                        <Text text="{i18n>authDescribeFirst}" class="aplHint admFldEmpty" visible="{= ${auth>fields}.length === 0 }"/>
                                </VBox>
                        </VBox>

                        <!-- ==================== 事务码规则 ==================== -->
                        <VBox renderType="Bare" class="apvPane" visible="{= ${auth>/admTab} === 'rules' }">
                                <Text text="{i18n>authRuleHint}" class="admNote"/>

                                <HBox alignItems="Center" justifyContent="SpaceBetween" class="admSecHead">
                                        <Text text="{= ${i18n>admRulesTitle} + '  ·  ' + ${auth>/rules}.length }" class="admSecTitle"/>
                                        <Button text="{i18n>admNew}" icon="sap-icon://add" type="Transparent" press=".onAuthNewRule" class="admLink"/>
                                </HBox>
                                <List items="{path: 'auth>/rules', templateShareable: false}" itemPress=".onAuthPickRule" showSeparators="None" noDataText="{i18n>authNoRules}" class="admPickList">
                                        <CustomListItem type="Active" class="admPickItem">
                                                <customData>
                                                        <core:CustomData key="on" value="{= ${auth>tcodePat} === ${auth>/editRule/tcodePat} ? 'yes' : 'no' }" writeToDom="true"/>
                                                </customData>
                                                <HBox alignItems="Center" class="admPickRow">
                                                        <VBox renderType="Bare" class="apvMain">
                                                                <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                                <HBox alignItems="Center" class="admChips">
                                                                        <Text text="{auth>tcodePat}" class="apvChip apvChipTcode"/>
                                                                        <Text text="{auth>targetText}" class="admArrow"/>
                                                                        <Text text="{i18n>admRuleOff}" class="apvChip" visible="{= ${auth>active} !== 'X' }"/>
                                                                        <Text text="{i18n>admAllowAllTag}" class="apvChip" visible="{= ${auth>allowAll} === 'X' }"/>
                                                                        <Text text="{i18n>admOwnMapTag}" class="apvChip admOwnTag" visible="{= ${auth>ownMap} === 'X' }"/>
                                                                </HBox>
                                                        </VBox>
                                                        <Text text="{auth>modeText}" class="apvStatus" wrapping="false">
                                                                <customData>
                                                                        <core:CustomData key="mode" value="{auth>ruleMode}" writeToDom="true"/>
                                                                </customData>
                                                        </Text>
                                                </HBox>
                                        </CustomListItem>
                                </List>

                                <VBox renderType="Bare" class="admEditor">
                                        <Text text="{i18n>admEditRule}" class="admSecTitle"/>
                                        <HBox renderType="Bare" class="admTwoCol">
                                                <VBox renderType="Bare" class="aplField">
                                                        <Text text="{i18n>authPattern}" class="aplLabel aplReq"/>
                                                        <Input value="{auth>/editRule/tcodePat}" placeholder="{i18n>authPatternPh}" maxLength="20" class="aplInput aplMono"/>
                                                </VBox>
                                                <VBox renderType="Bare" class="aplField">
                                                        <Text text="{i18n>authColTable}" class="aplLabel"/>
                                                        <!-- 20261023：改为下拉（只列已登记的表）——字段映射跟着目标表走。
                                                             单向绑定 + change 里写回（「不指定」的键是 "-"：UI5 把空键当成"没选"）；
                                                             这样刷新下拉项时不会把正在编辑的目标表改掉 -->
                                                        <Select selectedKey="{= ${auth>/editRule/tabname} || '-' }" items="{path: 'auth>/ruleTables', templateShareable: false}"
                                                                forceSelection="false" width="100%" change=".onAuthRuleTable" class="admSel admSelTall">
                                                                <core:Item key="{auth>key}" text="{auth>text}"/>
                                                        </Select>
                                                </VBox>
                                        </HBox>
                                        <VBox renderType="Bare" class="aplField">
                                                <Text text="{i18n>authRuleMode}" class="aplLabel"/>
                                                <HBox renderType="Bare" class="admPills admModePills">
                                                        <Button text="{i18n>authModeAUTO}" type="Transparent" press=".onAdmRuleMode" class="admPill">
                                                                <customData>
                                                                        <core:CustomData key="mode" value="AUTO"/>
                                                                        <core:CustomData key="on" value="{= ${auth>/editRule/ruleMode} === 'AUTO' ? 'yes' : 'no' }" writeToDom="true"/>
                                                                </customData>
                                                        </Button>
                                                        <Button text="{i18n>authModeAPPROVE}" type="Transparent" press=".onAdmRuleMode" class="admPill">
                                                                <customData>
                                                                        <core:CustomData key="mode" value="APPROVE"/>
                                                                        <core:CustomData key="on" value="{= ${auth>/editRule/ruleMode} === 'APPROVE' ? 'yes' : 'no' }" writeToDom="true"/>
                                                                </customData>
                                                        </Button>
                                                        <Button text="{i18n>authModeBLOCK}" type="Transparent" press=".onAdmRuleMode" class="admPill">
                                                                <customData>
                                                                        <core:CustomData key="mode" value="BLOCK"/>
                                                                        <core:CustomData key="on" value="{= ${auth>/editRule/ruleMode} === 'BLOCK' ? 'yes' : 'no' }" writeToDom="true"/>
                                                                </customData>
                                                        </Button>
                                                </HBox>
                                        </VBox>
                                        <HBox alignItems="Center" class="admToggle">
                                                <VBox renderType="Bare" class="apvMain">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <Text text="{i18n>authAllowAll}" class="admToggleTitle"/>
                                                </VBox>
                                                <Switch state="{auth>/editRule/allowAll}"/>
                                        </HBox>
                                        <HBox alignItems="Center" class="admToggle">
                                                <VBox renderType="Bare" class="apvMain">
                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                        <Text text="{i18n>authActive}" class="admToggleTitle"/>
                                                </VBox>
                                                <Switch state="{auth>/editRule/active}"/>
                                        </HBox>
                                </VBox>

                                <!-- 20261023：本规则的字段映射（沿用权限表的 / 本规则单独一份）；本卡片绑定 /editRule -->
                                <VBox renderType="Bare" class="admEditor" binding="{auth>/editRule}">
                                        <Text text="{i18n>admMapTitle}" class="admSecTitle"/>
                                        <Text text="{i18n>admRuleMapNoTable}" class="aplHint admFldEmpty" visible="{= !${auth>tabname} }"/>
                                        <VBox renderType="Bare" visible="{= !!${auth>tabname} }">
                                                <HBox renderType="Bare" class="admPills admMapPills">
                                                        <Button text="{i18n>admRuleMapInherit}" type="Transparent" press=".onAdmRuleMap" class="admPill">
                                                                <customData>
                                                                        <core:CustomData key="map" value="inherit"/>
                                                                        <core:CustomData key="on" value="{= ${auth>ownMap} ? 'no' : 'yes' }" writeToDom="true"/>
                                                                </customData>
                                                        </Button>
                                                        <Button text="{i18n>admRuleMapOwn}" type="Transparent" press=".onAdmRuleMap" class="admPill">
                                                                <customData>
                                                                        <core:CustomData key="map" value="own"/>
                                                                        <core:CustomData key="on" value="{= ${auth>ownMap} ? 'yes' : 'no' }" writeToDom="true"/>
                                                                </customData>
                                                        </Button>
                                                </HBox>
                                                <!-- 沿用：一行只读摘要 -->
                                                <VBox renderType="Bare" class="admMapSum" visible="{= !${auth>ownMap} }">
                                                        <Text text="{auth>baseHint}" class="admMapSumHead"/>
                                                        <HBox renderType="Bare" items="{path: 'auth>baseMap', templateShareable: false}" class="admMapChips">
                                                                <Text text="{auth>text}" class="admMapChip"/>
                                                        </HBox>
                                                        <Text text="{i18n>admRuleMapInheritTip}" class="aplMsg"/>
                                                </VBox>
                                                <!-- 单独：与权限表配置同一个映射列表 -->
                                                <VBox renderType="Bare" visible="{= !!${auth>ownMap} }">
                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="admMapBar">
                                                                <Text text="{auth>ownHint}" class="admMapSumHead">
                                                                        <layoutData><FlexItemData growFactor="1" minWidth="0"/></layoutData>
                                                                </Text>
                                                                <Button text="{i18n>admRuleMapRecopy}" icon="sap-icon://copy" type="Transparent" press=".onAuthRuleRecopy" class="admLink"/>
                                                        </HBox>
                                                        <core:Fragment fragmentName="zai.chat.view.AuthFieldMap" type="XML"/>
                                                </VBox>
                                        </VBox>
                                </VBox>
                        </VBox>
                </VBox>

                <!-- ===== 页脚：各页签自己的主操作，固定在底部 ===== -->
                <HBox alignItems="Center" justifyContent="SpaceBetween" class="aplFoot" visible="{= ${auth>/admTab} === 'records' }">
                        <Text text="{= ${auth>/admin/rows}.length ? (${auth>/admin/skip} + 1) + ' - ' + (${auth>/admin/skip} + ${auth>/admin/rows}.length) + ' / ' + ${auth>/admin/total} : '0' }" class="aplPagerText"/>
                        <HBox alignItems="Center" class="admPager">
                                <Button text="{i18n>authPrev}" icon="sap-icon://navigation-left-arrow" type="Transparent" press=".onAuthPage" enabled="{= ${auth>/admin/skip} > 0 }" class="apvBtn apvBtnReject admBtn">
                                        <customData>
                                                <core:CustomData key="list" value="admin"/>
                                                <core:CustomData key="delta" value="-50"/>
                                        </customData>
                                </Button>
                                <Button text="{i18n>authNext}" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Transparent" press=".onAuthPage" enabled="{= ${auth>/admin/skip} + 50 &lt; ${auth>/admin/total} }" class="apvBtn apvBtnReject admBtn">
                                        <customData>
                                                <core:CustomData key="list" value="admin"/>
                                                <core:CustomData key="delta" value="50"/>
                                        </customData>
                                </Button>
                        </HBox>
                </HBox>

                <HBox alignItems="Center" justifyContent="SpaceBetween" class="aplFoot" visible="{= ${auth>/admTab} === 'batch' }">
                        <Text text="{i18n>admBatchHint}" class="aplPagerText admFootHint"/>
                        <Button text="{i18n>authBatchSubmit}" type="Emphasized" press=".onAuthBatchAdd" class="apvBtn aplSubmit"/>
                </HBox>

                <HBox alignItems="Center" justifyContent="SpaceBetween" class="aplFoot" visible="{= ${auth>/admTab} === 'tables' }">
                        <Text text="{= ${auth>/editTable/loaded} ? ${auth>/editTable/loaded} + '  ·  ' + ${auth>/editTable/fields}.length + ' ' + ${i18n>admFieldsUnit} : ${i18n>admTableFootHint} }" class="aplPagerText admFootHint"/>
                        <Button text="{i18n>authSaveTable}" type="Emphasized" press=".onAuthSaveTable" class="apvBtn aplSubmit"/>
                </HBox>

                <HBox alignItems="Center" justifyContent="SpaceBetween" class="aplFoot" visible="{= ${auth>/admTab} === 'rules' }">
                        <Button text="{i18n>authDeleteRule}" type="Transparent" press=".onAuthDeleteRule" visible="{= !!${auth>/editRule/tcodePat} }" class="apvBtn apvBtnReject admBtn"/>
                        <Button text="{i18n>authSaveRule}" type="Emphasized" press=".onAuthSaveRule" class="apvBtn aplSubmit"/>
                </HBox>

        </VBox>

</core:FragmentDefinition>
