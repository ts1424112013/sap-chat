<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">

        <!-- ======================= 字段映射列表（权限表配置 / 事务码规则共用，20261023） =======================
             放在 binding="{auth>/editTable}" 或 binding="{auth>/editRule}" 的容器里，这里只用相对路径（fields / mapType / constVal）。
             规则单独映射时每行多 baseType / baseConst / baseText（权限表自己的映射）：与权限表不同的行 data-diff="yes"，
             映射下拉标蓝、字段名下显示「权限表：…」（显隐由 CSS 按 data-diff 控制，style-gale.css .admFld*）。 -->
        <HBox renderType="Bare" class="admFldRow admFldHead" visible="{= ${auth>fields}.length > 0 }">
                <Text text="{i18n>authFldName}"/>
                <Text text="{i18n>authFldKey}"/>
                <Text text="{i18n>authFldType}"/>
                <Text text="{i18n>authFldMap}"/>
                <Text text="{i18n>authFldConst}"/>
        </HBox>
        <VBox items="{path: 'auth>fields', templateShareable: false}" class="admFldList">
                <HBox renderType="Bare" class="admFldRow">
                        <customData>
                                <core:CustomData key="diff" writeToDom="true"
                                        value="{= ${auth>baseType} !== undefined &amp;&amp; (${auth>mapType} !== ${auth>baseType} || ((${auth>mapType} === 'CONST' || ${auth>mapType} === 'SEQ' || ${auth>mapType} === 'RULE') &amp;&amp; ${auth>constVal} !== ${auth>baseConst})) ? 'yes' : 'no' }"/>
                        </customData>
                        <VBox renderType="Bare" class="admFldNameBox">
                                <Text text="{auth>fieldname}" class="admFldName"/>
                                <Text text="{= ${i18n>admFldBase} + ${auth>baseText} }" class="admFldBase" visible="{= !!${auth>baseText} }"/>
                        </VBox>
                        <Text text="{= ${auth>keyflag} === 'X' ? '●' : '' }" class="admFldKey"/>
                        <Text text="{= ${auth>datatype} + ' · ' + ${auth>leng} }" class="admFldType"/>
                        <Select selectedKey="{auth>mapType}" items="{path: 'auth>/mapTypes', templateShareable: false}" class="admSel"
                                tooltip="{= ${auth>mapType} === 'RANDOM' ? ${i18n>authMapRandomHint} : ${auth>mapType} === 'SEQ' ? ${i18n>authMapSeqHint} : ${auth>mapType} === 'RULE' ? ${auth>/genText/ruleHint} : '' }">
                                <core:Item key="{auth>key}" text="{auth>text}"/>
                        </Select>
                        <Input value="{auth>constVal}" valueLiveUpdate="true" maxLength="60"
                                enabled="{= ${auth>mapType} === 'CONST' || ${auth>mapType} === 'SEQ' || ${auth>mapType} === 'RULE' }" class="aplInput admFldConst"
                                tooltip="{= ${auth>mapType} === 'SEQ' ? ${i18n>authMapSeqHint} : ${auth>mapType} === 'RULE' ? ${auth>/genText/ruleHint} : '' }"
                                placeholder="{= ${auth>mapType} === 'RANDOM' ? ${i18n>authMapRandomAuto} : ${auth>mapType} === 'SEQ' ? ${i18n>authMapSeqPh} : ${auth>mapType} === 'RULE' ? ${auth>/genText/rulePh} : '' }"/>
                        <!-- 10.27 #02：递增序号 / 规则组合 —— 就地示例或错误（与后端同口径，utils/AuthValueRule）+ 规则占位一点即插 -->
                        <Text text="{parts: ['auth>mapType', 'auth>constVal', 'auth>datatype', 'auth>leng'], formatter: '.authGenHint'}"
                                visible="{= ${auth>mapType} === 'SEQ' || ${auth>mapType} === 'RULE' }" class="admFldGen">
                                <customData>
                                        <core:CustomData key="kind" writeToDom="true"
                                                value="{parts: ['auth>mapType', 'auth>constVal', 'auth>datatype', 'auth>leng'], formatter: '.authGenKind'}"/>
                                </customData>
                        </Text>
                        <HBox renderType="Bare" class="admFldTokens" visible="{= ${auth>mapType} === 'RULE' }"
                                items="{path: 'auth>/ruleTokens', templateShareable: false}">
                                <Button text="{auth>label}" tooltip="{auth>tip}" type="Transparent" press=".onAuthRuleToken" class="admTok"/>
                        </HBox>
                </HBox>
        </VBox>

</core:FragmentDefinition>
