<core:FragmentDefinition
        xmlns="sap.m"
        xmlns:f="sap.ui.layout.form"
        xmlns:core="sap.ui.core">

        <!-- ======================= 模型新增/编辑对话框 ======================= -->
        <!-- 保存时调用 OData 函数导入 SaveModelCfg，在 ABAP 表 ZAI_MODEL_CFG 中 upsert 配置 -->
        <Dialog id="modelEditDialog"
                contentWidth="36rem"
                resizable="true">
                <!-- V5.2：自定义头部（标题 + 右上角 × 关闭） -->
                <customHeader>
                        <Toolbar design="Transparent" class="dlgHeadToolbar">
                                <Title level="H3" text="{i18n>modelEditTitle}" class="dlgHeadTitle"/>
                                <ToolbarSpacer/>
                                <Button icon="sap-icon://decline" type="Transparent"
                                        tooltip="{i18n>cancel}" press=".onCancelModel" class="dlgCloseBtn"/>
                        </Toolbar>
                </customHeader>
                <content>
                        <f:SimpleForm editable="true"
                                layout="ResponsiveGridLayout"
                                labelSpanL="4" labelSpanM="4" labelSpanS="12"
                                emptySpanL="1" emptySpanM="1"
                                columnsL="1" columnsM="1"
                                singleContainerFullSize="false">
                                <f:content>
                                        <Label text="{i18n>fldModelId}" required="true"/>
                                        <Input id="meModelId" value="{me>/ModelId}" placeholder="OLLAMA_LOCAL_01" maxLength="20"/>
                                        <Label text="{i18n>fldModelName}" required="true"/>
                                        <Input value="{me>/ModelName}" placeholder="本地 Ollama - Qwen2.5:14B" maxLength="60"/>
                                        <Label text="{i18n>fldModelDesc}"/>
                                        <Input value="{me>/ModelDesc}" maxLength="120"/>
                                        <Label text="{i18n>fldModelType}" required="true"/>
                                        <Select selectedKey="{me>/ModelType}">
                                                <items>
                                                        <core:Item key="OLLAMA" text="OLLAMA（本地 Ollama 服务）"/>
                                                        <core:Item key="OPENAI" text="OPENAI（OpenAI 兼容：vLLM/DeepSeek/通义等）"/>
                                                </items>
                                        </Select>
                                        <Label text="{i18n>fldEndpoint}" required="true"/>
                                        <Input value="{me>/EndpointUrl}" placeholder="http://192.168.1.50:11434/api/chat"/>
                                        <Label text="{i18n>fldDestination}"/>
                                        <Input value="{me>/Destination}" placeholder="（可选）SM59 类型 G 目的地"/>
                                        <Label text="{i18n>fldApiModel}"/>
                                        <Input value="{me>/ApiModel}" placeholder="qwen2.5:14b / deepseek-chat" maxLength="120"/>
                                        <Label text="{i18n>fldApiKey}"/>
                                        <Input value="{me>/ApiKey}" type="Password" placeholder="{i18n>fldApiKeyPh}"/>
                                        <Label text="{i18n>fldAuthType}"/>
                                        <Select selectedKey="{me>/AuthType}">
                                                <items>
                                                        <core:Item key="NONE" text="NONE（无鉴权，本地服务常用）"/>
                                                        <core:Item key="BEARER" text="BEARER（Authorization: Bearer xxx）"/>
                                                        <core:Item key="X_API_KEY" text="X_API_KEY（请求头 x-api-key）"/>
                                                </items>
                                        </Select>
                                        <Label text="{i18n>fldTemperature}"/>
                                        <Input value="{me>/Temperature}" placeholder="0.3"/>
                                        <Label text="{i18n>fldMaxTokens}"/>
                                        <Input value="{me>/MaxTokens}" placeholder="4096"/>
                                        <Label text="{i18n>fldTimeout}"/>
                                        <Input value="{me>/TimeoutSec}" placeholder="300"/>
                                        <Label text="{i18n>fldActive}"/>
                                        <CheckBox selected="{me>/ActiveBool}"/>
                                        <!-- V10：模型级源码分析开关（取消勾选 = 该模型不做源码解析，ZAI_MODEL_CFG-SKIP_SOURCE，对所有人生效） -->
                                        <Label text="{i18n>fldSkipSource}"/>
                                        <VBox>
                                                <CheckBox selected="{me>/SkipSourceBool}"/>
                                                <Text text="{i18n>fldSkipSourceHint}" class="hintText" wrapping="true"/>
                                        </VBox>
                                        <!-- V10：模型级代码权限（勾选 = USER 角色用此模型时不下发源码，仅程式用途说明；ADMIN 不受限，ZAI_MODEL_CFG-USER_HIDE_SRC） -->
                                        <Label text="{i18n>fldUserHideSrc}"/>
                                        <VBox>
                                                <CheckBox selected="{me>/UserHideSrcBool}"/>
                                                <Text text="{i18n>fldUserHideSrcHint}" class="hintText" wrapping="true"/>
                                        </VBox>
                                        <Text text="{i18n>modelEditHint}" class="hintText" wrapping="true"/>
                                </f:content>
                        </f:SimpleForm>
                </content>
                <buttons>
                        <Button text="{i18n>save}" press=".onSaveModel" type="Emphasized"/>
                        <Button text="{i18n>cancel}" press=".onCancelModel"/>
                </buttons>
        </Dialog>
</core:FragmentDefinition>
