<mvc:View controllerName="zai.chat.controller.App"
        displayBlock="true"
        height="100%"
        xmlns:mvc="sap.ui.core.mvc"
        xmlns="sap.m"
        xmlns:f="sap.ui.layout.form"
        xmlns:u="sap.ui.unified"
        xmlns:core="sap.ui.core">

        <App id="app">
                <pages>
                        <Page id="page" title="" showHeader="false" enableScrolling="false">
                                <content>
                                        <HBox height="100%" class="mainRow">

                                                <!-- ==================== 左侧边栏：品牌 / 工作模式 / 新建 / 历史 ==================== -->
                                                <VBox id="sideBar" class="sideBar" width="17rem">
                                                        <HBox class="brandRow" alignItems="Center">
                                                                <VBox class="logoChipSm" alignItems="Center" justifyContent="Center">
                                                                        <Image src="images/compass-logo.svg" decorative="true" densityAware="false" class="brandLogoImage"/>
                                                                </VBox>
                                                                <Title level="H3" text="{i18n>brandName}" class="brandName"/>
                                                        </HBox>

                                                        <!-- V12/V13：工作模式分段控件（对话 / Agent）——横向等宽，选中态纯 CSS -->
                                                        <VBox id="modeNav" class="modeNav">
                                                                <Button id="chatModeNav" type="Transparent"
                                                                        icon="sap-icon://discussion"
                                                                        text="{i18n>modeNavChat}"
                                                                        tooltip="{i18n>modeNavChatTip}"
                                                                        press=".onSelectWorkspaceMode"
                                                                        class="modeNavBtn">
                                                                        <customData>
                                                                                <core:CustomData key="mode" value="CHAT"/>
                                                                        </customData>
                                                                </Button>
                                                                <Button id="agentModeNav" type="Transparent"
                                                                        icon="sap-icon://lightbulb"
                                                                        text="{i18n>modeNavAgent}"
                                                                        tooltip="{i18n>modeNavAgentTip}"
                                                                        press=".onSelectWorkspaceMode"
                                                                        class="modeNavBtn">
                                                                        <customData>
                                                                                <core:CustomData key="mode" value="AGENT"/>
                                                                        </customData>
                                                                </Button>
                                                        </VBox>

                                                        <Button id="newChatBtn" text="{chat>/newBtnLabel}" icon="sap-icon://add" press=".onNewSession"/>

                                                        <Text text="{chat>/histLabel}" class="histLabel"/>

                                                        <!-- V10：会话搜索（前端按标题过滤） -->
                                                        <SearchField id="sessionSearch"
                                                                placeholder="{i18n>sessSearch}"
                                                                liveChange=".onSearchSession"
                                                                class="sessSearch"/>

                                                        <!-- 历史会话列表：后端模式读 ZAI_CHAT_SESS，演示模式存本地 -->
                                                        <List id="sessionList"
                                                                items="{path: 'session>/sessions', factory: '.sessionItemFactory', templateShareable: false}"
                                                                showSeparators="None"
                                                                backgroundDesign="Transparent"
                                                                noDataText="{i18n>noSessions}"
                                                                class="sessionList">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                        </List>

                                                        <HBox class="sideFoot" alignItems="Center" justifyContent="SpaceBetween">
                                                                <ObjectStatus id="modeBadge" class="modeBadge"/>
                                                                <Button icon="sap-icon://action-settings" type="Transparent" press=".onOpenSettings" tooltip="{i18n>settings}" class="sideSetBtn"/>
                                                        </HBox>
                                                </VBox>

                                                <!-- ==================== 主区域 ==================== -->
                                                <VBox width="100%" class="mainCol">

                                                        <!-- 顶栏：折叠侧栏 / 工作模式徽标 / 当前会话标题 / 模型切换 / 设置 -->
                                                        <Toolbar class="topBar">
                                                                <Button id="sideToggle" icon="sap-icon://menu2" type="Transparent" press=".onToggleSide" tooltip="{i18n>toggleSide}" class="topBtn"/>
                                                                <!-- V12：当前工作模式徽标（对话 / Agent · 类型） -->
                                                                <Text id="topModeBadge" text="{chat>/modeLabel}" class="topModeBadge"/>
                                                                <Text text="{session>/title}" class="sessTitle"/>
                                                                <ToolbarSpacer/>
                                                                <ComboBox id="modelSelect"
                                                                        width="13rem"
                                                                        placeholder="{i18n>selectModel}"
                                                                        tooltip="{i18n>selectModel}"
                                                                        items="{path: 'chat>/models', templateShareable: false}"
                                                                        selectedKey="{chat>/currentModel}"
                                                                        change=".onModelChange"
                                                                        class="modelSelect">
                                                                        <items>
                                                                                <core:Item key="{chat>ModelId}" text="{chat>ModelName}"/>
                                                                        </items>
                                                                </ComboBox>
                                                                        <!-- V12：Agent 任务信息入口（仅 Agent 任务会话可见） -->
                                                                        <Button id="agentInfoBtn" icon="sap-icon://information" type="Transparent"
                                                                                tooltip="{i18n>agentInfoBtn}" press=".onAgentTaskInfo"
                                                                                visible="{chat>/agentInfoVisible}" class="topBtn"/>
                                                                        <!-- V6.0：明暗主题切换（持久化见 App.controller onToggleTheme） -->
                                                                        <Button id="themeToggle" icon="sap-icon://night-mode" type="Transparent" press=".onToggleTheme" tooltip="{i18n>themeToggle}" class="topBtn themeToggle"/>
                                                                        <Button icon="sap-icon://download" tooltip="{i18n>exportMd}" press=".onExportSession" class="topBtn"/>
                                                                        <Button icon="sap-icon://excel-attachment" tooltip="{i18n>exportCsv}" press=".onExportCsv" class="topBtn"/>
                                                                        <Button icon="sap-icon://action-settings" tooltip="{i18n>settings}" press=".onOpenSettings" class="sapUiTinyMarginBegin"/>
                                                        </Toolbar>

                                                        <!-- ============ 空状态：居中大输入框（对话/Agent 两模式复用，文案随模式） ============ -->
                                                        <VBox id="hero" class="heroArea" alignItems="Center" justifyContent="Center" visible="{chat>/heroVisible}">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                                <VBox class="logoChip" alignItems="Center" justifyContent="Center">
                                                                        <Text text="✦"/>
                                                                </VBox>
                                                                <Title level="H2" text="{chat>/heroTitle}" class="heroTitle"/>
                                                                <!-- V7：hero 副标题；V13：Agent 模式换为 Agent 引导文案 -->
                                                                <Text text="{chat>/heroSub}" class="heroSub"/>
                                                                <!-- V5.5：快捷指令「泡泡」（仅对话模式；Agent 空状态不放业务泡泡）
                                                                     （控制器 _renderHeroBubbles 程序化渲染） -->
                                                                <VBox id="bubbleField" class="heroBubbleField"
                                                                        visible="{= ${chat>/workspaceMode} === 'CHAT' }"/>

                                                                <!-- V4.3：输入卡（含内部右下角发送键）保持原结构，仅位于胶囊下方 -->
                                                                <VBox class="inputCard heroCard" width="100%">
                                                                        <TextArea id="heroInput"
                                                                                growing="true"
                                                                                growingMaxLines="7"
                                                                                rows="2"
                                                                                width="100%"
                                                                                placeholder="{chat>/heroPh}"
                                                                                valueLiveUpdate="true"
                                                                                value="{chat>/input}"
                                                                                class="chatInput"/>
                                                                        <!-- V9.3：附件回显行（已选附件名 + 移除），默认隐藏；
                                                                             V13：Agent 模式附件作为任务上下文，同样支持 -->
                                                                        <HBox id="attachRowHero" visible="false" alignItems="Center" class="attachRow">
                                                                                <Text id="attachNameHero" class="attachName"/>
                                                                                <Button id="attachDelHero" icon="sap-icon://decline" type="Transparent"
                                                                                        tooltip="{i18n>attachRemove}" press=".onAttachRemove" class="attachDel"/>
                                                                        </HBox>
                                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="inputFoot">
                                                                                <!-- V5.4：角色选择（仅对话模式；Agent 模式不用角色前缀） -->
                                                                                <HBox alignItems="Center" class="roleBox"
                                                                                        visible="{= ${chat>/workspaceMode} === 'CHAT' }">
                                                                                        <ComboBox id="roleSelectHero"
                                                                                                width="10rem"
                                                                                                placeholder="{i18n>roleNone}"
                                                                                                tooltip="{i18n>roleTip}"
                                                                                                change=".onRoleChange"
                                                                                                class="roleCombo"/>
                                                                                        <Button id="roleMngHero" icon="sap-icon://user-edit" type="Transparent"
                                                                                                tooltip="{i18n>roleManage}" press=".onOpenRoleManage" class="roleMngBtn"/>
                                                                                </HBox>
                                                                                <!-- V9.3：文本附件上传 + 发送；
                                                                                     V13：Agent 模式下附件按钮保留（作为上下文） -->
                                                                                <HBox alignItems="Center">
                                                                                        <u:FileUploader id="attachHero"
                                                                                                buttonOnly="true"
                                                                                                buttonText=""
                                                                                                icon="sap-icon://attachment"
                                                                                                style="Transparent"
                                                                                                tooltip="{i18n>attachTip}"
                                                                                                change=".onFileChosen"
                                                                                                uploadOnChange="false"
                                                                                                class="attachBtn"/>
                                                                                        <!-- V13：Agent 模式提示标签（输入框右下角） -->
                                                                                        <Text text="{i18n>agentModeHint}" class="agentModeHint"
                                                                                                visible="{= ${chat>/workspaceMode} === 'AGENT' }"/>
                                                                                        <Button id="sendBtnHero" icon="sap-icon://paper-plane" press=".onSend" type="Emphasized" tooltip="{i18n>send}" class="sendBtn"/>
                                                                                </HBox>
                                                                        </HBox>
                                                                </VBox>
                                                        </VBox>

                                                        <!-- ============ 对话态：消息列表 ============ -->
                                                        <ScrollContainer id="chatScroll" height="100%" width="100%" vertical="true" horizontal="false" visible="{chat>/listVisible}">
                                                                <layoutData>
                                                                        <FlexItemData growFactor="1"/>
                                                                </layoutData>
                                                                <List id="msgList"
                                                                        items="{path: 'chat>/messages', factory: '.msgItemFactory', templateShareable: false}"
                                                                        showSeparators="None"
                                                                        backgroundDesign="Transparent"/>
                                                        </ScrollContainer>

                                                        <!-- ============ 对话态：底部输入 ============ -->
                                                        <HBox class="inputDock" justifyContent="Center" visible="{chat>/listVisible}">
                                                                <VBox class="inputCard" width="100%">
                                                                        <!-- V5.4：对话态不再显示快捷指令行（仅首页泡泡形式保留）
                                                                             V12：占位文案随模式（Agent = 任务输入）；角色/附件仅对话模式可用 -->
                                                                        <TextArea id="msgInput"
                                                                                growing="true"
                                                                                growingMaxLines="7"
                                                                                rows="1"
                                                                                width="100%"
                                                                                placeholder="{chat>/inputPh}"
                                                                                valueLiveUpdate="true"
                                                                                value="{chat>/input}"
                                                                                class="chatInput"/>
                                                                        <!-- V9.3：附件回显行（V12：仅对话模式显示，控制器统一同步） -->
                                                                        <HBox id="attachRowDock" visible="false" alignItems="Center" class="attachRow">
                                                                                <Text id="attachNameDock" class="attachName"/>
                                                                                <Button id="attachDelDock" icon="sap-icon://decline" type="Transparent"
                                                                                        tooltip="{i18n>attachRemove}" press=".onAttachRemove" class="attachDel"/>
                                                                        </HBox>
                                                                        <HBox alignItems="Center" justifyContent="SpaceBetween" class="inputFoot">
                                                                                <!-- V5.4：左侧角色选择（V12：Agent 模式隐藏 —— 角色前缀不进入任务提问） -->
                                                                                <HBox alignItems="Center" class="roleBox"
                                                                                        visible="{= ${chat>/workspaceMode} === 'CHAT' }">
                                                                                        <ComboBox id="roleSelectDock"
                                                                                                width="10rem"
                                                                                                placeholder="{i18n>roleNone}"
                                                                                                tooltip="{i18n>roleTip}"
                                                                                                change=".onRoleChange"
                                                                                                class="roleCombo"/>
                                                                                        <Button id="roleMngDock" icon="sap-icon://user-edit" type="Transparent"
                                                                                                tooltip="{i18n>roleManage}" press=".onOpenRoleManage" class="roleMngBtn"/>
                                                                                </HBox>
                                                                                <!-- V9.3：文本附件上传（V13：Agent 模式保留 —— 附件作为任务上下文拼入提问） -->
                                                                                <HBox alignItems="Center">
                                                                                        <u:FileUploader id="attachDock"
                                                                                                buttonOnly="true"
                                                                                                buttonText=""
                                                                                                icon="sap-icon://attachment"
                                                                                                style="Transparent"
                                                                                                tooltip="{i18n>attachTip}"
                                                                                                change=".onFileChosen"
                                                                                                uploadOnChange="false"
                                                                                                class="attachBtn"/>
                                                                                        <!-- V13：Agent 模式提示标签（输入框右下角） -->
                                                                                        <Text text="{i18n>agentModeHint}" class="agentModeHint"
                                                                                                visible="{= ${chat>/workspaceMode} === 'AGENT' }"/>
                                                                                        <Button id="sendBtn" icon="sap-icon://paper-plane" press=".onSend" type="Emphasized" tooltip="{i18n>send}" class="sendBtn"/>
                                                                                </HBox>
                                                                        </HBox>
                                                                </VBox>
                                                        </HBox>
                                                </VBox>
                                        </HBox>
                                </content>
                        </Page>
                </pages>
        </App>
</mvc:View>
